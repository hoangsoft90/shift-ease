{
  "metadata": {
    "version": "1.0.0",
    "description": "Golden test cases for ShiftEase Import Pipeline (state machine + INVARIANT-004)",
    "required_invariants": [
      "INVARIANT-004",
      "INVARIANT-002"
    ],
    "state_machine": "IDLE -> PARSING -> EXTRACTED -> REVIEWING -> COMMITTED"
  },
  "cases": [
    {
      "id": "IMPORT-001",
      "name": "Simple paste text import — HIGH confidence auto-reviewable",
      "type": "HAPPY_PATH",
      "input": {
        "sourceType": "PASTE_TEXT",
        "rawText": "Sep 03 Day 07:00-19:00\nSep 04 Night 19:00-07:00\nSep 05 OFF",
        "jobTimezone": "America/New_York",
        "existingTemplates": [
          {
            "id": "tpl-day",
            "name": "Day",
            "startTime": "07:00",
            "endTime": "19:00"
          },
          {
            "id": "tpl-night",
            "name": "Night",
            "startTime": "19:00",
            "endTime": "07:00+1"
          }
        ]
      },
      "expected": {
        "stateTransitions": [
          "IDLE",
          "PARSING",
          "EXTRACTED"
        ],
        "candidates": [
          {
            "data": {
              "date": "2026-09-03",
              "startTime": "07:00",
              "endTime": "19:00",
              "shiftType": "Day",
              "templateId": "tpl-day"
            },
            "confidence": "HIGH",
            "reviewStatus": "PENDING",
            "id": "cand-1"
          },
          {
            "data": {
              "date": "2026-09-04",
              "startTime": "19:00",
              "endTime": "07:00+1",
              "shiftType": "Night",
              "templateId": "tpl-night"
            },
            "confidence": "HIGH",
            "reviewStatus": "PENDING",
            "id": "cand-2"
          },
          {
            "data": {
              "date": "2026-09-05",
              "startTime": null,
              "endTime": null,
              "shiftType": "OFF",
              "templateId": null
            },
            "confidence": "HIGH",
            "reviewStatus": "PENDING",
            "id": "cand-3"
          }
        ],
        "committedOccurrences": [],
        "note": "All candidates are PENDING — NOT auto-committed. INVARIANT-004 holds."
      }
    },
    {
      "id": "IMPORT-002",
      "name": "Ambiguous input — LOW confidence, system MUST NOT auto-commit",
      "type": "INVARIANT_004_TEST",
      "invariant": "INVARIANT-004",
      "input": {
        "sourceType": "PASTE_TEXT",
        "rawText": "Mon 3rd\nTue\nWed??",
        "jobTimezone": "America/New_York",
        "existingTemplates": [
          {
            "id": "tpl-day",
            "name": "Day",
            "startTime": "07:00",
            "endTime": "19:00"
          }
        ]
      },
      "expected": {
        "stateTransitions": [
          "IDLE",
          "PARSING",
          "EXTRACTED"
        ],
        "candidates": [
          {
            "id": "cand-1",
            "data": {
              "date": null,
              "startTime": null,
              "endTime": null,
              "shiftType": "?",
              "templateId": null
            },
            "confidence": "LOW",
            "reviewStatus": "PENDING"
          },
          {
            "id": "cand-2",
            "data": {
              "date": null,
              "startTime": null,
              "endTime": null,
              "shiftType": "?",
              "templateId": null
            },
            "confidence": "LOW",
            "reviewStatus": "PENDING"
          },
          {
            "id": "cand-3",
            "data": {
              "date": null,
              "startTime": null,
              "endTime": null,
              "shiftType": "?",
              "templateId": null
            },
            "confidence": "LOW",
            "reviewStatus": "PENDING"
          }
        ],
        "committedOccurrences": [],
        "invariantCheck": {
          "INVARIANT-004": "No candidates are auto-committed. All remain PENDING until user explicitly confirms.",
          "expectedBehavior": "System shows 'Low confidence — please review' for each candidate. Bulk actions like 'Accept All High' skip LOW confidence candidates."
        },
        "note": "Each unparseable line yields its own LOW candidate (3 total). None is auto-committed — INVARIANT-004 holds."
      }
    },
    {
      "id": "IMPORT-003",
      "name": "User reviews and commits — state transition to COMMITTED",
      "type": "COMMIT_FLOW",
      "input": {
        "sourceType": "PASTE_TEXT",
        "candidatesFromImport001": [
          {
            "id": "cand-1",
            "confidence": "HIGH",
            "reviewStatus": "PENDING",
            "shiftDate": "2026-09-03",
            "shiftType": "Day",
            "startTime": "07:00",
            "endTime": "19:00",
            "templateId": "tpl-day"
          },
          {
            "id": "cand-2",
            "confidence": "HIGH",
            "reviewStatus": "PENDING",
            "shiftDate": "2026-09-04",
            "shiftType": "Night",
            "startTime": "19:00",
            "endTime": "07:00+1",
            "templateId": "tpl-night"
          },
          {
            "id": "cand-3",
            "confidence": "HIGH",
            "reviewStatus": "PENDING",
            "shiftDate": "2026-09-05",
            "shiftType": "Off",
            "startTime": null,
            "endTime": null,
            "templateId": null
          }
        ],
        "userActions": [
          {
            "candidateId": "cand-1",
            "action": "APPROVE"
          },
          {
            "candidateId": "cand-2",
            "action": "APPROVE"
          },
          {
            "candidateId": "cand-3",
            "action": "REJECT"
          },
          {
            "action": "COMMIT"
          }
        ],
        "jobTimezone": "America/New_York"
      },
      "expected": {
        "stateTransitions": [
          "REVIEWING",
          "COMMITTED"
        ],
        "committedOccurrences": [
          {
            "candidateId": "cand-1",
            "occurrenceCreated": true
          },
          {
            "candidateId": "cand-2",
            "occurrenceCreated": true
          },
          {
            "candidateId": "cand-3",
            "occurrenceCreated": false,
            "reason": "REJECTED"
          }
        ],
        "importSession": {
          "committedOccurrenceIds": [
            "occ-cand-1",
            "occ-cand-2"
          ],
          "auditTrail": "Each committed occurrence links back to ImportSession for traceability"
        },
        "invariantCheck": {
          "INVARIANT-002": "Each committed occurrence has startUtc/endUtc resolved from local time + timezone",
          "INVARIANT-004": "Commit only happened after explicit user actions (APPROVE + COMMIT button)"
        }
      }
    },
    {
      "id": "IMPORT-004",
      "name": "CSV import with column mapping",
      "type": "CSV_IMPORT",
      "input": {
        "sourceType": "CSV",
        "rawCsv": "Date,Shift,Start,End\n2026-09-03,Day,07:00,19:00\n2026-09-04,Night,19:00,07:00\n2026-09-05,Off,,",
        "columnMapping": {
          "date": "Date",
          "shiftType": "Shift",
          "startTime": "Start",
          "endTime": "End"
        },
        "jobTimezone": "America/New_York"
      },
      "expected": {
        "stateTransitions": [
          "IDLE",
          "PARSING",
          "EXTRACTED"
        ],
        "candidates": 3,
        "allConfidence": "HIGH",
        "note": "ISO dates + clear column mapping = HIGH confidence for all candidates."
      }
    },
    {
      "id": "IMPORT-005",
      "name": "Re-import diff — detect changed shifts",
      "type": "REIMPORT",
      "input": {
        "previousSession": {
          "id": "session-old",
          "createdAt": "2026-08-01T10:00:00Z",
          "sourceType": "PASTE_TEXT",
          "committedOccurrenceIds": [
            "occ-1",
            "occ-2",
            "occ-3"
          ],
          "rawExtraction": {
            "entries": [
              {
                "date": "2026-09-03",
                "shiftType": "Day",
                "start": "07:00",
                "end": "19:00"
              },
              {
                "date": "2026-09-04",
                "shiftType": "Night",
                "start": "19:00",
                "end": "07:00"
              },
              {
                "date": "2026-09-05",
                "shiftType": "Off",
                "start": null,
                "end": null
              }
            ]
          }
        },
        "newExtraction": {
          "entries": [
            {
              "date": "2026-09-03",
              "shiftType": "Night",
              "start": "19:00",
              "end": "07:00"
            },
            {
              "date": "2026-09-04",
              "shiftType": "Day",
              "start": "07:00",
              "end": "19:00"
            },
            {
              "date": "2026-09-05",
              "shiftType": "Day",
              "start": "07:00",
              "end": "19:00"
            },
            {
              "date": "2026-09-06",
              "shiftType": "Night",
              "start": "19:00",
              "end": "07:00"
            }
          ]
        }
      },
      "expected": {
        "diff": {
          "added": [
            {
              "date": "2026-09-06",
              "shiftType": "Night",
              "changeType": "ADDED"
            }
          ],
          "removed": [],
          "modified": [
            {
              "date": "2026-09-03",
              "from": "Day",
              "to": "Night",
              "changeType": "SWAPPED"
            },
            {
              "date": "2026-09-04",
              "from": "Night",
              "to": "Day",
              "changeType": "SWAPPED"
            },
            {
              "date": "2026-09-05",
              "from": "Off",
              "to": "Day",
              "changeType": "CHANGED"
            }
          ],
          "unchanged": []
        },
        "impact": {
          "totalHoursChanged": "Calculated from diff",
          "incomeImpact": "Requires PayRule to calculate",
          "availabilityImpact": "3 days changed + 1 day added"
        }
      }
    },
    {
      "id": "IMPORT-006",
      "name": "MEDIUM confidence — template mismatch requires user clarification",
      "type": "MEDIUM_CONFIDENCE",
      "input": {
        "sourceType": "PASTE_TEXT",
        "rawText": "Sep 03 19:00-07:00\nSep 04 07:00-19:00",
        "jobTimezone": "America/New_York",
        "existingTemplates": [
          {
            "id": "tpl-day",
            "name": "Day",
            "startTime": "07:00",
            "endTime": "19:00"
          },
          {
            "id": "tpl-night",
            "name": "Night",
            "startTime": "19:00",
            "endTime": "07:00+1"
          },
          {
            "id": "tpl-evening",
            "name": "Evening",
            "startTime": "15:00",
            "endTime": "23:00"
          }
        ]
      },
      "expected": {
        "candidates": [
          {
            "data": {
              "date": "2026-09-03",
              "startTime": "19:00",
              "endTime": "07:00+1",
              "shiftType": "Night",
              "templateId": "tpl-night"
            },
            "confidence": "MEDIUM",
            "reviewStatus": "PENDING",
            "note": "Time matches Night template exactly, but no shift type label in input — MEDIUM not HIGH.",
            "id": "cand-1"
          },
          {
            "data": {
              "date": "2026-09-04",
              "startTime": "07:00",
              "endTime": "19:00",
              "shiftType": "Day",
              "templateId": "tpl-day"
            },
            "confidence": "MEDIUM",
            "reviewStatus": "PENDING",
            "note": "Time matches Day template exactly, but no shift type label in input.",
            "id": "cand-2"
          }
        ],
        "committedOccurrences": [],
        "note": "MEDIUM confidence = system suggests template but requires user confirmation."
      }
    },
    {
      "id": "IMPORT-007",
      "name": "Parse failure — returns to IDLE with error",
      "type": "ERROR_HANDLING",
      "input": {
        "sourceType": "CSV",
        "rawCsv": "not,a,valid,schedule",
        "columnMapping": null
      },
      "expected": {
        "stateTransitions": [
          "IDLE",
          "PARSING",
          "ERROR"
        ],
        "error": {
          "type": "PARSE_FAILED",
          "message": "Unable to extract schedule data from input",
          "recoverable": true
        },
        "committedOccurrences": [],
        "note": "System returns to IDLE-equivalent error state. User can retry with different input."
      }
    },
    {
      "id": "IMPORT-008",
      "name": "Bulk accept only HIGH confidence, skip MEDIUM/LOW",
      "type": "BULK_ACTION",
      "input": {
        "candidates": [
          {
            "id": "c-1",
            "confidence": "HIGH",
            "reviewStatus": "PENDING"
          },
          {
            "id": "c-2",
            "confidence": "MEDIUM",
            "reviewStatus": "PENDING"
          },
          {
            "id": "c-3",
            "confidence": "HIGH",
            "reviewStatus": "PENDING"
          },
          {
            "id": "c-4",
            "confidence": "LOW",
            "reviewStatus": "PENDING"
          },
          {
            "id": "c-5",
            "confidence": "MEDIUM",
            "reviewStatus": "PENDING"
          }
        ],
        "bulkAction": "ACCEPT_ALL_HIGH"
      },
      "expected": {
        "afterBulkAction": [
          {
            "id": "c-1",
            "reviewStatus": "APPROVED"
          },
          {
            "id": "c-2",
            "reviewStatus": "PENDING"
          },
          {
            "id": "c-3",
            "reviewStatus": "APPROVED"
          },
          {
            "id": "c-4",
            "reviewStatus": "PENDING"
          },
          {
            "id": "c-5",
            "reviewStatus": "PENDING"
          }
        ],
        "note": "Only HIGH confidence candidates are bulk-accepted. MEDIUM and LOW remain PENDING for manual review."
      }
    }
  ]
}